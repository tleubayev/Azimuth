# ---------------------------------------------------------------------------
# Compass on Telegram — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Compass API (server-only; proxied via /api/compass/[...path]) ---
COMPASS_API_KEY=
# Optional: override the Compass API base URL (defaults to https://api.compasslabs.ai)
COMPASS_API_SERVER_URL=

# --- Global Markets Perps builder fee (optional) ---
# Hyperliquid account that collects the 0.1% builder fee charged on perps CLOSES
# (opens are free). Must be an account you control holding >=100 USDC on
# Hyperliquid perps, or both the one-time approval and fee'd closes are rejected
# by the exchange. The market-order / approve-builder-fee routes inject this
# server-side, so the fee can't be stripped client-side. Public value (it appears
# on-chain in every order). Leave UNSET to disable the fee (perps trade fee-free).
NEXT_PUBLIC_PERPS_BUILDER_ADDRESS=

# --- Spot (tokenized-assets) partner fee ---
# Optional partner fee charged on SELL/exit only, taken from the USDC proceeds
# and sent to this address: atomically for Midas RWA swaps, via a post-fill
# charge for Ondo equities. The custom sell / charge-fee routes inject it
# server-side so it can't be stripped client-side. Public value (appears
# on-chain). Leave UNSET to disable the fee (spot trades fee-free).
NEXT_PUBLIC_TOKENIZED_FEE_ADDRESS=
# Fee as a percentage of the USDC proceeds (default 1 = 1%).
NEXT_PUBLIC_TOKENIZED_FEE_PERCENT=

# --- Halliday fiat on-ramp ("Buy with card", tokenized/Ethereum only) ---
# This app holds NO Halliday key. "Buy with card" opens the Compass-hosted
# /onramp/checkout page (in landing_page) in the system browser via Telegram
# openLink — that page holds the publishable key server-side. Set this to that
# page's origin (landing_page), NOT this app's NEXT_PUBLIC_APP_URL. Defaults to
# https://compasslabs.ai/onramp/checkout.
NEXT_PUBLIC_ONRAMP_CHECKOUT_URL=https://compasslabs.ai/onramp/checkout

# --- Privy (embedded EVM wallet) ---
# Public app id from the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Privy SERVER-SIDE signing (so the user is never prompted to sign) ---
# The embedded wallet is delegated to the app's authorization key (a Privy "key
# quorum"); the server then signs every trade/bridge action via @privy-io/node.
# Setup: Privy dashboard → create an authorization key / key quorum →
#   1. PRIVY_APP_SECRET                       app secret (server-only)
#   2. PRIVY_AUTHORIZATION_KEY                the key quorum's authorization private
#      key (base64 PKCS8; the `wallet-auth:` prefix, if present, is stripped)
#   3. NEXT_PUBLIC_PRIVY_AUTHORIZATION_KEY_ID the key quorum id (used client-side by
#      addSigners to delegate the wallet to the server)
# For a fully prompt-free experience, also enable automatic server delegation at
# wallet creation in the dashboard, and configure a gas sponsor (the server tx
# pays no native gas from the embedded wallet).
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
NEXT_PUBLIC_PRIVY_AUTHORIZATION_KEY_ID=
# Optional: defaults to NEXT_PUBLIC_PRIVY_APP_ID server-side.
PRIVY_APP_ID=

# --- Telegram bot ---
# Server-only bot token from BotFather — used as the HMAC key to verify initData.
TELEGRAM_BOT_TOKEN=

# --- App / TON Connect ---
# Public HTTPS origin of the deployed app (NOT a .xyz domain — Telegram rejects those).
# REQUIRED: also used server-side as the allowed ton_proof domain. Must be the real
# origin or TON wallet sign-in fails.
NEXT_PUBLIC_APP_URL=https://mono-8nom.vercel.app
# Optional. The TON Connect manifest is served dynamically at /tonconnect-manifest.json
# and derives url/iconUrl from the request origin, so this normally stays UNSET.
# Only set it to point the wallet at a different absolute manifest URL.
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=

# --- Symbiosis (TON -> EVM bridge) ---
# Optional partner id / client id for fee attribution.
SYMBIOSIS_PARTNER_ID=
NEXT_PUBLIC_SYMBIOSIS_CLIENT_ID=
# Optional override of the Symbiosis API base (defaults to https://api.symbiosis.finance/crosschain).
SYMBIOSIS_API_URL=
# Optional TON-side input token for bridge quotes (jetton master address or "TON" for native). Defaults to "TON".
SYMBIOSIS_TON_TOKEN_IN=

# --- Server secret (HMAC for nonces + signed session) ---
# Stable secret used to sign ton_proof nonces and the session cookie. Falls back
# to TELEGRAM_BOT_TOKEN if unset. In PRODUCTION one of the two MUST be set
# (serverSecret hard-fails otherwise) so tokens verify across serverless instances.
NONCE_SECRET=

# --- RPC URLs (server-only; used by the Compass proxy for gas-sponsored writes) ---
ETHEREUM_MAINNET_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=
HYPEREVM_MAINNET_RPC_URL=
# Optional gas sponsor private key for sponsored embedded-wallet writes.
GAS_SPONSOR_PK=

# --- Optional: TON-keyed identity (Privy custom auth via ton_proof JWT) ---
# Set to "true" to key the embedded EVM wallet to the TON address instead of the
# Telegram account. Requires the JWT signing key + a reachable JWKS endpoint.
NEXT_PUBLIC_ENABLE_TON_KEYED_IDENTITY=false
# PEM (or base64) private key used to sign the Privy custom-auth JWT (server-only).
PRIVY_JWT_PRIVATE_KEY=
PRIVY_JWT_KID=compass-ton-1
PRIVY_JWT_ISSUER=https://your-app.vercel.app
